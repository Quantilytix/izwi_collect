<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/promptCategoryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/izwi_accent"
        android:textStyle="bold"
        android:textSize="12sp"
        tools:text="SALES EXPENSE REPLIES" />

    <TextView
        android:id="@+id/promptTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        tools:text="Mari yenyu yaonekwa, maita basa." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/editPromptButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit" />

        <Button
            android:id="@+id/deletePromptButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E5E5E5" />

</LinearLayout>
