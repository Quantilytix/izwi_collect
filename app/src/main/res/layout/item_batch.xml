<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/batchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        tools:text="batch_1700000000_ab12cd34 — 24 clips" />

    <TextView
        android:id="@+id/batchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/izwi_muted"
        tools:text="uploaded — https://huggingface.co/..." />

    <Button
        android:id="@+id/retryButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retry"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#E5E5E5" />
</LinearLayout>
