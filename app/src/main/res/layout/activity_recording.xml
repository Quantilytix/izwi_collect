<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/izwi_muted"
        tools:text="12 / 40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/categoryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/izwi_accent"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/editPromptButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit prompt" />

    </LinearLayout>

    <TextView
        android:id="@+id/promptText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="26sp"
        android:textStyle="bold" />

    <com.quantilytix.izwi.recording.LevelMeterView
        android:id="@+id/levelMeter"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/elapsedTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0.0s"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/warningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/izwi_warning"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/recordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recording_record"
            android:backgroundTint="@color/izwi_primary" />

        <Button
            android:id="@+id/replayButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/recording_replay" />

        <Button
            android:id="@+id/retakeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/recording_retake" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/skipButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recording_skip" />

        <Button
            android:id="@+id/acceptButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/recording_accept"
            android:backgroundTint="@color/izwi_accent" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/finishSessionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="Review queue"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_primary" />

        <Button
            android:id="@+id/scriptProgressButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:text="Script progress"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/izwi_primary" />

    </LinearLayout>

</LinearLayout>
