<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/izwi_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/app_tagline"
        android:textColor="@color/izwi_muted" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/consent_speaker_id_label"
        android:textColor="@color/izwi_muted" />

    <EditText
        android:id="@+id/speakerIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. audry_001"
        android:inputType="text"
        android:autofillHints="username" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Language"
        android:textColor="@color/izwi_muted" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/languageToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@id/languageShonaButton"
        app:singleSelection="true"
        app:selectionRequired="true">

        <Button
            android:id="@+id/languageShonaButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Shona" />

        <Button
            android:id="@+id/languageNdebeleButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="isiNdebele" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <Button
        android:id="@+id/startSessionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/consent_continue"
        android:backgroundTint="@color/izwi_primary" />

    <Button
        android:id="@+id/manageScriptButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="@color/izwi_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Prompts" />

</LinearLayout>
