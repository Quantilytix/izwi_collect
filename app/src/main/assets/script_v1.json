  "prompts": [
    {"id": "sales_001", "category": "sales_expense_replies", "text": "Mari yenyu yaonekwa, maita basa."},
    {"id": "sales_002", "category": "sales_expense_replies", "text": "Chikwereti chenyu chapera nhasi."},
    {"id": "sales_003", "category": "sales_expense_replies", "text": "Tenga tapedza kutumira mari yenyu."},
    {"id": "sales_004", "category": "sales_expense_replies", "text": "Kutengesa kwanhasi kwakanaka chaizvo."},
    {"id": "sales_005", "category": "sales_expense_replies", "text": "Mari yekutengesa yasvika mangwanani ano."},
    {"id": "stock_001", "category": "stock_inventory", "text": "Zvigadzirwa zvapera mustock nhasi."},
    {"id": "stock_002", "category": "stock_inventory", "text": "Tine zvigadzirwa zvishoma chete zvasara."},
    {"id": "stock_003", "category": "stock_inventory", "text": "Tichaisa zvimwe zvigadzirwa mangwana."},
    {"id": "stock_004", "category": "stock_inventory", "text": "Ongorora stock isati yapera."},
    {"id": "stock_005", "category": "stock_inventory", "text": "Zvinhu zvitsva zvasvika kuchitoro."},
    {"id": "numbers_001", "category": "prices_quantities_dates_times", "text": "Mutengo wacho imadhora gumi nemashanu."},
    {"id": "numbers_002", "category": "prices_quantities_dates_times", "text": "Tine zvigadzirwa makumi maviri nezvishanu."},
    {"id": "numbers_003", "category": "prices_quantities_dates_times", "text": "Muripo unofanira kubhadharwa nazvino mangwana."},
    {"id": "numbers_004", "category": "prices_quantities_dates_times", "text": "Nhamba yekodhi ndeye gumi nembiri."},
    {"id": "numbers_005", "category": "prices_quantities_dates_times", "text": "Chiitiko chichaitika nemuchetondo weshanu."},
    {"id": "names_001", "category": "names", "text": "Mutengi anonzi Tendai ari kumira."},
    {"id": "names_002", "category": "names", "text": "Musiyi wezvinhu ndiye Sekuru Moyo."},
    {"id": "names_003", "category": "names", "text": "Chitoro chiri paHarare Road, Mbare."},
    {"id": "names_004", "category": "names", "text": "Mutengesi anonzi Chipo achasvika mangwana."},
    {"id": "names_005", "category": "names", "text": "Musika uri kuMbare Musika chaiwo."},
    {"id": "confirm_001", "category": "confirmations_clarifications", "text": "Ndazvinzwisisa, tichaita saizvozvo."},
    {"id": "confirm_002", "category": "confirmations_clarifications", "text": "Ndapota dzokororai zvamataura."},
    {"id": "confirm_003", "category": "confirmations_clarifications", "text": "Chokwadi here kuti mutengo ndiwoyu?"},
    {"id": "confirm_004", "category": "confirmations_clarifications", "text": "Hongu, zvose zvaita saizvozvo."},
    {"id": "confirm_005", "category": "confirmations_clarifications", "text": "Kwete, ndapota tsanangurai zvakare."},
    {"id": "errors_001", "category": "errors_apologies_warnings", "text": "Ndine urombo, pane chakanganisika pano."},
    {"id": "errors_002", "category": "errors_apologies_warnings", "text": "Pamusoroi, tichagadzirisa izvi nekukurumidza."},
    {"id": "errors_003", "category": "errors_apologies_warnings", "text": "Yeuchidzo, mari yenyu haisati yasvika."},
    {"id": "errors_004", "category": "errors_apologies_warnings", "text": "Ndapota ongororai zvakare mabhuku enyu."},
    {"id": "errors_005", "category": "errors_apologies_warnings", "text": "Zvine njodzi kuramba muchidaro."},
    {"id": "conv_001", "category": "natural_conversation", "text": "Makadii nhasi, mabasa ari kufamba sei?"},
    {"id": "conv_002", "category": "natural_conversation", "text": "Ndatenda nekuuya kwenyu nhasi uno."},
    {"id": "conv_003", "category": "natural_conversation", "text": "Tichaonana zvakare mangwana masikati."},
    {"id": "conv_004", "category": "natural_conversation", "text": "Zvinhu zviri kufamba zvakanaka kwazvo."},
    {"id": "conv_005", "category": "natural_conversation", "text": "Ndine mubvunzo mumwe chete kwauri."},
    {"id": "mixed_001", "category": "shona_english_business_terms", "text": "Tinofanira kuisa invoice muSmart-Q nhasi."},
    {"id": "mixed_002", "category": "shona_english_business_terms", "text": "Report yestock ichabuda mangwana masikati."},
    {"id": "mixed_003", "category": "shona_english_business_terms", "text": "Payment yacho yaenda kuaccount rako."},
    {"id": "mixed_004", "category": "shona_english_business_terms", "text": "Order itsva yasvika kubhizimisi manje manje."},
    {"id": "mixed_005", "category": "shona_english_business_terms", "text": "Customer anoda kuziva balance yake."}
