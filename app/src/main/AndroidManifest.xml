<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".IzwiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Izwi"
        android:usesCleartextTraffic="false">

        <!-- Consent screen is disabled for now for this internal recording pass.
             Re-wire the LAUNCHER intent-filter back onto ConsentActivity when
             this ships to a public/external speaker. -->
        <activity android:name=".consent.ConsentActivity" android:exported="false" />

        <activity
            android:name=".session.SessionSetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".session.ScriptEditorActivity" android:exported="false" />
        <activity android:name=".recording.RecordingActivity" android:exported="false" />
        <activity android:name=".review.ReviewQueueActivity" android:exported="false" />
        <activity android:name=".sync.SyncStatusActivity" android:exported="false" />

    </application>

</manifest>
